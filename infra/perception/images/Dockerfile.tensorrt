ARG CUDA_IMAGE=nvidia/cuda:13.3.0-tensorrt-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_MODULE_LOADING=LAZY \
    L4STACK_REQUIRE_CUDA=1 \
    L4STACK_DISABLE_CPU_FALLBACK=1 \
    L4STACK_MIN_COMPUTE_CAPABILITY=12.0

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake git ninja-build pkg-config \
      python3.12 python3.12-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m pip install --break-system-packages --upgrade \
      pip setuptools wheel packaging \
    && python3.12 -m pip install --break-system-packages \
      cuda-python \
      numpy \
      onnx

WORKDIR /workspace
CMD ["sleep", "infinity"]
